# PostgreSQL local
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="emprestimo_equipamento"
POSTGRES_PORT="55432"

# Aplicacao e Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/emprestimo_equipamento?schema=public"
APP_PORT="3000"

# Chave do HMAC dos tokens de sessao (Spec 005). Obrigatoria. Em producao use uma chave
# longa e aleatoria (pelo menos 32 caracteres), definida no painel da Vercel, nunca no git.
SESSION_SECRET="replace-with-a-random-secret"

# Seed (Spec 004): senha da conta do professor, lida so ao rodar `npm run db:seed`.
# Defina o valor real fora do git (shell ou .env local). Nunca coloque no codigo.
SEED_PROFESSOR_PASSWORD="replace-with-the-class-password"

# Conta de teste opcional do seed (Spec 004): as duas juntas ou nenhuma. Nao e a do professor.
# SEED_TESTE_EMAIL="voce@exemplo.com"
# SEED_TESTE_PASSWORD="replace-with-a-test-password"

# URL publica base do bucket de imagens (sem segredo), ex.: .../storage/v1/object/public/equipamentos
EQUIPAMENTOS_IMAGENS_BASE_URL="http://localhost:3000/imagens-equipamentos"

# Skill imagens-equipamentos (ADR-003): chave gratuita da API do Pixabay.
# Coloque o valor real so em .env.local (ignorado pelo git).
PIXABAY_API_KEY="replace-with-your-pixabay-key"
