{
  "name": "emprestimo-equipamento",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "dev": "node node_modules/next/dist/bin/next dev",
    "prebuild": "node scripts/limpar-next.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/prisma/build/index.js migrate deploy && node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@trpc/client": "11.28.0",
    "@trpc/server": "11.28.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "20.17.58",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "prisma": "6.12.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
