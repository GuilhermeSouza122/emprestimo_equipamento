generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  colaborador
  operacoes

  @@map("papel")
}

enum CategoriaEquipamento {
  notebook
  monitor
  cabo
  camera

  @@map("categoria_equipamento")
}

enum SituacaoEquipamento {
  disponivel
  manutencao
  emprestado

  @@map("situacao_equipamento")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nome      String
  papel     Papel
  senhaHash String   @map("senha_hash")
  createdAt DateTime @default(now()) @map("created_at")
  sessoes   Sessao[]

  @@map("usuarios")
}

model Sessao {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique @map("token_hash")
  usuarioId  Int       @map("usuario_id")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiraEm   DateTime  @map("expira_em")
  revogadaEm DateTime? @map("revogada_em")

  @@index([usuarioId])
  @@map("sessoes")
}

model Equipamento {
  id            Int                  @id @default(autoincrement())
  patrimonio    String               @unique
  nome          String
  categoria     CategoriaEquipamento
  situacao      SituacaoEquipamento
  imagemArquivo String               @map("imagem_arquivo")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@map("equipamentos")
}

model SystemStatus {
  id        Int      @id @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_status")
}
